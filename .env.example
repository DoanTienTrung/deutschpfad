POSTGRES_USER=deutschpfad
POSTGRES_PASSWORD=deutschpfad
POSTGRES_DB=deutschpfad

# Email (local dev: để trống, tự dùng MailDev không cần auth). Production trên Render đặt biến mail trong
# Render Dashboard (Brevo cổng 2525, xem ops/render-neon-setup.md), không đặt ở đây.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
VITE_API_ORIGIN=http://localhost:8080
DEEPGRAM_API_KEY=your-deepgram-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
UNSPLASH_API_KEY=your-unsplash-access-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Generate with: openssl rand -base64 64
JWT_SECRET=your-random-256-bit-plus-secret-here

COHERE_API_KEY=


# ---- Production trên Render + Neon (ops/render-neon-setup.md) ----
# Biến production đặt trong Render Dashboard (danh sách ở render.yaml), không đặt ở file này.
# 3 dòng dưới chỉ để chạy backend ở máy nhà trỏ vào database Neon (docker-compose.neon.yml):
NEON_JDBC_URL=
NEON_USER=
NEON_PASSWORD=

# Địa chỉ giao diện khi chạy "npm run dev" (Vite, cổng 5173). Chạy bằng docker compose thì bỏ dòng này:
# mặc định là http://localhost:8081.
FRONTEND_URL=http://localhost:5173
