POSTGRES_USER=deutschpfad
POSTGRES_PASSWORD=deutschpfad
POSTGRES_DB=deutschpfad

# Email (local dev: để trống, tự dùng MailDev không cần auth)
# Production qua Gmail SMTP: điền các biến dưới, MAIL_FROM phải TRÙNG với MAIL_USERNAME
# (Gmail từ chối/ghi đè "From" khác với tài khoản đã xác thực)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
VITE_API_ORIGIN=http://localhost:8080
DEEPGRAM_API_KEY=your-deepgram-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
UNSPLASH_API_KEY=your-unsplash-access-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Generate with: openssl rand -base64 64
JWT_SECRET=your-random-256-bit-plus-secret-here

# Production only — nơi nhận email cảnh báo khi cookie YouTube (youtube-cookies.txt trên
# server) hết hạn, khiến yt-dlp không lấy được phụ đề tự động nữa. Mặc định dùng MAIL_FROM
# nếu để trống. Không cần đặt khi chạy local (yt-dlp không bị chặn từ IP nhà).
YTDLP_HEALTHCHECK_ALERT_EMAIL=
